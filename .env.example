PORT=4000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=""
DB_NAME=evalznow

# --- Security ---
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://evalz.metrocoding.com,http://localhost:3000
FRONTEND_URL=https://evalz.metrocoding.com
EMAIL_USER=
EMAIL_PASS=
# NODE_ENV=production        # enables HSTS and refuses to start with a weak JWT_SECRET
# TRUST_PROXY=loopback       # reverse proxy (nginx/Apache) on the same machine
# API_MAX_PER_MINUTE=1500    # per-IP request ceiling
# LOGIN_MAX_ATTEMPTS=10      # failed logins per 15 min per IP+username
# DB_POOL_MAX=10
# REPORT_CONCURRENCY=4       # parallel candidate processing in data reports
# AUTO_DB_INDEXES=true       # create performance indexes on startup
# COMPRESSION=on             # set "off" only if nginx already gzips API responses
# EXPOSE_ERRORS=false        # true = show raw error text (debug only)
