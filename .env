LOGIN_MAX_ATTEMPTS=10      # failed logins per 15 min per IP+username
DB_POOL_MAX=10
REPORT_CONCURRENCY=4       # parallel candidate processing in data reports
AUTO_DB_INDEXES=true       # create performance indexes on startup
COMPRESSION=on             # set "off" only if nginx already gzips API responses
EXPOSE_ERRORS=false        # true = show raw error text (debug only)
